<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Schedule Medication Reminder</title>
</head>
<body>
    <h2>Medication Reminder Form</h2>
    <form action="send_reminder.php" method="POST">
        <label>Full Name:</label><br>
        <input type="text" name="full_name" required><br><br>

        <label>Email Address:</label><br>
        <input type="email" name="email" required><br><br>

        <label>Phone Number:</label><br>
        <input type="text" name="phone" required><br><br>

        <label>Medication:</label><br>
        <input type="text" name="medication" required><br><br>

        <label>Schedule Date:</label><br>
        <input type="date" name="schedule_date" required><br><br>

        <button type="submit">Send Reminder</button>
    </form>
</body>
</html>
